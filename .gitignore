.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db

# -------------------------
# Node / Next.js / Frontend
# -------------------------
node_modules/
.next/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*.local
!.env.example

# -------------------------
# Python / Django / Backend
# -------------------------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
*.log
*.sqlite3
db.sqlite3
venv/
env/
.venv/
.Python
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

