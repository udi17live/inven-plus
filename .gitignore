# -------------------------
*.swp
*.swo
*.bak
*.tmp
*.orig
*.lock
package-lock.json
pip-wheel-metadata/
__pypackages__/

# -------------------------
# Docker / Containers
# -------------------------
*.pid
*.seed
*.pid.lock
*.pidfile
logs/
tmp/
docker-compose.override.yml
.env.docker

# -------------------------
# Monorepo specific
# -------------------------
/frontend/node_modules/
/backend/__pycache__/
/apps/*/node_modules/
/apps/*/__pycache__/
/packages/*/dist/
/packages/*/node_modules/
/packages/*/build/

